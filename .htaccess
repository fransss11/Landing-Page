# Nonaktifkan MultiViews agar permintaan tanpa ekstensi
Options -MultiViews

# Aktifkan modul rewrite
RewriteEngine On

# 1. Redirect permintaan "/file.php" → "/file"
RewriteCond %{THE_REQUEST} \s/([^.]+)\.php[?\s] [NC]
RewriteRule ^ /%1 [R=301,L]

# 2. Jika URL tidak mengarah ke file atau direktori nyata,
#    coba layani "$uri.php"
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.php -f
RewriteRule ^(.+?)/?$ $1.php [L]
